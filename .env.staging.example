# Copy to .env.staging locally. This file contains names/placeholders only.
STAGING_ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=coderzclub-staging

# Must be an isolated staging Mongo deployment. The database name is enforced
# by scripts/ops/start-staging.ps1; never use the production coderzclub DB.
MONGODB_URI=mongodb://<staging-user>:<staging-password>@<staging-mongo-host>:27017/?replicaSet=<staging-rs>
SPRING_DATA_MONGODB_DATABASE=coderzclub_staging

# Generate unique values for staging; do not reuse production or demo secrets.
JWT_SECRET=<random-staging-jwt-secret-at-least-64-bytes>
REDIS_PASSWORD=<random-staging-redis-password>
REDIS_DATABASE=0
RABBITMQ_USERNAME=<staging-rabbit-user>
RABBITMQ_PASSWORD=<random-staging-rabbit-password>
RABBITMQ_VHOST=/coderzclub-staging
SUBMISSION_QUEUE_NAME=coderzclub.staging.submissions
SUBMISSION_QUEUE_EXCHANGE=coderzclub.staging.submissions.exchange
SUBMISSION_QUEUE_RETRY_NAME=coderzclub.staging.submissions.retry
SUBMISSION_QUEUE_DLQ_NAME=coderzclub.staging.submissions.dlq
CONTEST_RUN_QUEUE_NAME=coderzclub.staging.contest-runs
CONTEST_RUN_QUEUE_EXCHANGE=coderzclub.staging.contest-runs.exchange

# Private staging Judge0 endpoint. Judge0 is not run by this Compose project.
JUDGE0_API_URL=http://<private-staging-judge0-host>:2358/submissions
JUDGE0_AUTH_MODE=SELF_HOSTED
# JUDGE0_API_KEY=<staging-only-key-if-required>

APP_BACKEND_URL=https://staging-api.<example-domain>
APP_FRONTEND_URL=https://staging.<example-domain>
APP_CORS_ALLOWED_ORIGINS=https://staging.<example-domain>
APP_EMAIL_FROM=staging-noreply@<example-domain>
SPRING_MAIL_ENABLED=false
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# Optional loopback bindings for a local validation run.
STAGING_API_PORT=8080
STAGING_API_MANAGEMENT_PORT=8081
WORKER_MAX_GLOBAL_JUDGE0_CONCURRENCY=2
