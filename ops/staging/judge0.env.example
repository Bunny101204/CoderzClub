# Secure staging Judge0 integration names only. Do not run Judge0 on the
# Windows Docker Desktop demo host and do not disable isolate --cg.
JUDGE0_API_URL=http://<private-staging-judge0-host>:2358/submissions
JUDGE0_AUTH_MODE=SELF_HOSTED
# JUDGE0_API_KEY=<staging-only-key-if-required>
JUDGE0_WAIT=true
JUDGE0_CONNECT_TIMEOUT_SECONDS=20
JUDGE0_TIMEOUT_SECONDS=120
JUDGE0_COMPILE_TIME_LIMIT_SECONDS=30
JUDGE0_MAX_CPU_TIME_LIMIT_SECONDS=60
JUDGE0_MEMORY_LIMIT_UNIT=KB
SUBMISSION_MAX_MEMORY_KB=262144
